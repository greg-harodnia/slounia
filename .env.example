PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI support agent. Both providers speak the OpenAI format; pick with ASSIST_PROVIDER.
ASSIST_PROVIDER=groq

# Groq (default provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (used when ASSIST_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
